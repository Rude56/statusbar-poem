<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      刻意不申请 INTERNET：本模块全程离线，SystemUI 侧也不许联网。
      白名单需要列出已安装应用，因此声明 QUERY_ALL_PACKAGES（仅本应用进程使用）。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PoemStatus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          只读配置通道：被 Hook 的 SystemUI 进程通过 ContentResolver.call() 读取 JSON 配置。
          SystemUI 不读 App 私有目录；Provider 内无任何写入口，只暴露 join 后的配置字符串。
        -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.github.rude56.poemstatus.config"
            android:exported="true" />

        <!--
          模块声明全部放在 src/main/resources/META-INF/xposed/ 下，不再用 meta-data：
            java_init.list —— 入口类
            module.prop    —— minApiVersion / targetApiVersion / staticScope=true
            scope.list     —— com.android.systemui
          静态作用域（staticScope）只有现代模块能声明；旧的 xposedscope meta-data
          只是「建议列表」，用户可以把模块勾到任意应用上。
        -->
    </application>

</manifest>
