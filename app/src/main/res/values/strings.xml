    <string name="app_name">状态栏古诗</string>
    <!-- 现代 libxposed 模块用 android:description 作为模块描述（不再用 xposeddescription）。 -->
    <string name="module_description">诗句从状态栏右侧滚入，只遮住诗句正下方那一小段，播完把时钟还给你，停一会儿再播下一首。完全离线，省电。只作用于系统界面。</string>

